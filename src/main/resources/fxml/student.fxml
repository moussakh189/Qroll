<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.qroll.gui.StudentController">

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="search-bar">
        <padding>
            <Insets top="12" right="20" bottom="12" left="20"/>
        </padding>

        <Label text="Search:" styleClass="field-label"/>
        <TextField fx:id="searchField"
                   promptText="Name or student ID..."
                   prefWidth="260"
                   styleClass="search-field"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Import CSV"
                onAction="#onImportCSV"
                styleClass="btn-secondary"
                prefHeight="34"/>

        <Button text="+ Add Student"
                onAction="#onAddStudent"
                styleClass="btn-start"
                prefHeight="34"/>

        <Button text="Delete Selected"
                onAction="#onDeleteSelected"
                styleClass="btn-end"
                prefHeight="34"/>
    </HBox>

    <TableView fx:id="studentTable" VBox.vgrow="ALWAYS" styleClass="dark-table">
        <columns>
            <TableColumn fx:id="idCol"        text="Matricule" prefWidth="120"/>
            <TableColumn fx:id="lastNameCol"  text="Nom"       prefWidth="130"/>
            <TableColumn fx:id="firstNameCol" text="Prénom"    prefWidth="130"/>
            <TableColumn fx:id="sectionCol"   text="Section"   prefWidth="80"/>
            <TableColumn fx:id="groupCol"     text="Groupe"    prefWidth="80"/>
            <TableColumn fx:id="emailCol"     text="Email"     prefWidth="180"/>
        </columns>
        <placeholder>
            <Label text="No students yet — add one or import a CSV file." styleClass="hint-label"/>
        </placeholder>
    </TableView>


    <HBox styleClass="search-bar" alignment="CENTER_LEFT" spacing="16">
        <padding><Insets top="8" right="20" bottom="8" left="20"/></padding>
        <Label fx:id="statusLabel" text="0 students" styleClass="hint-label"/>
        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="prevButton" text="&lt; Prev" onAction="#onPrevPage" styleClass="btn-secondary"/>
        <Label fx:id="pageLabel" text="Page 1 of 1" styleClass="field-label"/>
        <Button fx:id="nextButton" text="Next &gt;" onAction="#onNextPage" styleClass="btn-secondary"/>

        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="importStatusLabel" text="" styleClass="hint-label"/>
    </HBox>

    <VBox fx:id="addForm" spacing="12" styleClass="report-card" managed="false" visible="false">
        <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>

        <Label text="ADD NEW STUDENT" styleClass="report-card-title"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="4">
                <Label text="Matricule" styleClass="field-label"/>
                <TextField fx:id="newIdField" promptText="e.g. 84903889" prefWidth="110" styleClass="search-field"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Nom" styleClass="field-label"/>
                <TextField fx:id="newLastNameField" promptText="e.g. AMARA" prefWidth="130" styleClass="search-field"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Prénom" styleClass="field-label"/>
                <TextField fx:id="newFirstNameField" promptText="e.g. IMANE" prefWidth="130" styleClass="search-field"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Section" styleClass="field-label"/>
                <TextField fx:id="newSectionField" promptText="e.g. C" prefWidth="70" styleClass="search-field"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Groupe" styleClass="field-label"/>
                <TextField fx:id="newGroupField" promptText="e.g. 1" prefWidth="70" styleClass="search-field"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Email" styleClass="field-label"/>
                <TextField fx:id="newEmailField" promptText="e.g. imane@univ.dz" prefWidth="150" styleClass="search-field"/>
            </VBox>
        </HBox>
        <HBox spacing="10">
            <Button text="Save Student" onAction="#onSaveNewStudent" styleClass="btn-start" prefWidth="150"/>
            <Button text="Cancel"       onAction="#onCancelAdd"      styleClass="btn-end"   prefWidth="100"/>
        </HBox>

        <Label fx:id="formErrorLabel" text="" style="-fx-text-fill: #f85149;"/>
    </VBox>


</VBox>
